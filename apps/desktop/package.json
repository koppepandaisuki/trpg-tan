{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TRPG デスクトップアプリ(Tauri + Vite + React)。キャラシ/ビルド/PLAY を担う。@trpg/core を共有。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
