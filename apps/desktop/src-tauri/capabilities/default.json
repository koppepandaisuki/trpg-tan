{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの既定権限。.ccsheet 保存/読込のため dialog と fs(テキスト読み書き)を許可。購入物の DL のため http(DL API + 署名URL取得)と fs(バイナリ書込/読込/mkdir)を許可。fs はダイアログで選んだ任意パスや appLocalData を対象にするため広めのスコープ(ローカルデスクトップ前提)。http はローカル開発サーバと https を許可(自前コードのみ実行される前提の MVP スコープ)。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "deep-link:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "https://**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    }
  ]
}
