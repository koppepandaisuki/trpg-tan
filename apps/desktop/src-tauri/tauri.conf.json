{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRPG Desktop",
  "version": "0.0.0",
  "identifier": "com.trpgtan.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["paradice"]
      }
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter desktop dev",
    "beforeBuildCommand": "pnpm --filter desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "TRPG Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
