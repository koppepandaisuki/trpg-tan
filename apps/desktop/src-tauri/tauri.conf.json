{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParaDaice",
  "version": "0.1.42",
  "identifier": "com.trpgtan.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["paradice"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/koppepandaisuki/trpg-tan/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGQ0E2QTlBNEY3MkY0NDUKUldSRjlISlBtbXJLSDJ0RFA3ODh4OVZsYVBiNTJMMU1lbWkySTNXZVh3Y2swWlNvYXVBek5jb2sK"
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter desktop dev",
    "beforeBuildCommand": "pnpm --filter desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "パラDa-iCE",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
