# デスクトップアプリの Supabase 接続(Web と同じプロジェクトの公開値)。
# このファイルを apps/desktop/.env にコピーして値を入れる。
# 値は Web の .env の NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY と同じ。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 購入物 DL API を持つ Web アプリのベース URL。
# ローカル開発で Next を動かす場合は http://localhost:3000、
# 本番は配信ドメイン(例: https://paradice.example.com)。
VITE_WEB_BASE_URL=http://localhost:3000

# テスター用「不具合報告」ボタンの送信先 Discord webhook(任意)。
# 設定すると右下に報告ボタンが出て、直近のログ/エラーを 1 クリックで Discord
# へ送れる。未設定ならボタンは出ない。テスターのビルドで有効化するにはこの値を
# 各自の .env に入れる必要がある(.env は git 管理外)。
VITE_DISCORD_WEBHOOK_URL=
