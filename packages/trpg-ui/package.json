{
  "name": "@trpg/ui",
  "version": "0.0.0",
  "private": true,
  "description": "TRPG 共有 UI: キャラクターシートのエディタ一式。デスクトップ(Vite)と Web(Next.js)が同じコンポーネントを使う(保存・読込は SheetIO として注入)。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sheet.css": "./src/sheet/sheet.css",
    "./character-sheet": "./src/sheet/CharacterSheet.tsx",
    "./generic-sheet-editor": "./src/sheet/GenericSheetEditor.tsx",
    "./sheet-system-picker": "./src/sheet/SheetSystemPicker.tsx",
    "./new-character-menu": "./src/sheet/NewCharacterMenu.tsx",
    "./io": "./src/sheet/io.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trpg/core": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.424.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "lucide-react": "^0.424.0",
    "react": "^18.3.1",
    "typescript": "^5.5.3"
  }
}
