{
  "name": "@trpg/core",
  "version": "0.0.0",
  "private": true,
  "description": "TRPG 共有コア: 型・ダイスエンジン・システム定義(CoC6/7)。Web とデスクトップアプリの双方から参照する純 TypeScript パッケージ(ランタイム依存なし)。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dice": "./src/dice/index.ts",
    "./systems": "./src/systems/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
