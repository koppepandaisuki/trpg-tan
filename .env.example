# =========================================================
# .env.example
# 実値は .env.local にコピーして入れる(.env.local は git 管理しない)
# =========================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 2 以降で使用) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに絶対に渡さない。lib/supabase/admin.ts でのみ参照。
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 7 以降で使用) ---
STRIPE_SECRET_KEY=
# Stripe Webhook の署名検証に必須(platform endpoint 用)
STRIPE_WEBHOOK_SECRET=
# Stripe Connect 用 webhook endpoint の署名検証(D-020 PR2 以降)。
# Dashboard で Connect endpoint (connect: true) を別途登録し、同じ URL
# `/api/stripe/webhook` に向け、その whsec をここに入れる。未設定の場合は
# platform endpoint だけが有効になる(Connect イベントは届かない)。
STRIPE_CONNECT_WEBHOOK_SECRET=
# 公開可能キー(クライアントから参照可能)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Google ログイン (Supabase Auth の Google Provider、任意) ---
# Supabase Dashboard で Google Provider を有効化 + Google Cloud Console で
# OAuth 2.0 Client ID を作成済みなら true にする(desktop の「ブラウザでログイン」も
# この Web ログイン画面を経由するため、ここが有効になれば desktop からも使える)。
# 未設定/true 以外なら login/signup ページに Google ボタンを出さない
# (Provider 未設定のまま出すと「Provider not enabled」エラーがテスターに見えるため)。
# lib/auth/google-config.ts 参照。NEXT_PUBLIC_ プレフィクスなので Vercel では
# Production / Preview の両方に設定すること。
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# --- AI 出品審査 (モデレーション、任意) ---
# 設定すると、出品が審査に出される(pending)とき Anthropic API で内容を一次判定し、
# admin の審査キューに助言(allow/flag/block)を表示する。サーバー専用。
# 未設定なら AI 審査はスキップされ、従来通り admin が手動で審査する(機能オフ)。
# モデルは claude-haiku-4-5(高速・安価)を使用。lib/moderation/ai-screen.ts で参照。
# PLAY のルールブック Q&A の「運営 AI」(従量課金)でも同じキーを使う
# (app/api/ai/complete)。ユーザーは 1 回ごとにゴールドを消費し、運営がこの
# キーで Anthropic を呼ぶ。未設定なら運営 AI は 503(準備中)を返し、ユーザーが
# 自分のキーを設定する BYOK 方式にフォールバックする。
ANTHROPIC_API_KEY=
# 運営 AI が使うモデル(未設定は claude-haiku-4-5)。app/api/ai/complete で参照。
ANTHROPIC_MODEL=
# 運営 AI 1 回あたりの消費ゴールド(未設定は 2)。app/api/ai/complete / lib/gold.ts で参照。
# 根拠: claude-haiku-4-5 は $1/$5 per MTok(入力/出力)。抜粋+質問+max_tokens=1024の
# 実コストは軽量な質問で ¥0.3、抜粋5件程度の中量な質問で ¥0.8 程度(¥150/$1 換算、
# 抜粋8件×4000字+質問2000字+出力上限の極端なケースでも ¥4 程度)。1ゴールド=¥1の
# 等価レートのため 2 にすることで軽量〜中量は黒字を確保しつつプレイヤー負担は
# 実質無視できる水準(300ゴールドパックで150回分)に抑える。
AI_GOLD_COST=

# --- メール通知 (Resend、任意) ---
# 審査の承認/却下時にクリエイターへ結果をメール通知する。サーバー専用。
# RESEND_API_KEY と EMAIL_FROM の両方が揃ったときだけ送信(片方でも欠けると no-op)。
# EMAIL_FROM は Resend で検証済みドメインの差出人を指定する。
# 例: EMAIL_FROM="Re-dice <noreply@example.com>"
# 未設定なら通知はスキップされる(審査操作自体は従来通り動く)。lib/email/ で参照。
RESEND_API_KEY=
EMAIL_FROM=

# --- Feedback (α 期間中の収集) ---
# In-app feedback button が POST するサーバーから Discord webhook 経由で
# クローズドサーバーに転送する。未設定の場合は POST は 200 で受け付けるが
# Discord 配信は走らない(α 起ち上げ時の運用猶予)。
DISCORD_FEEDBACK_WEBHOOK_URL=

# --- 管理画面アクセス制限 (Stripe セキュリティチェックリスト対応、本番は必須) ---
# /admin/* への Basic 認証。Vercel Hobby プランは IP アローリスト機能が無いため、
# IP 制限の代替としてこれを設定する(middleware.ts)。両方揃って初めて有効化される。
# 未設定のままだと管理画面が無防備(開発中のみ許容)。
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=

# --- 異常検知アラート (日次ダイジェスト、任意) ---
# Vercel Cron(vercel.json)が毎日 /api/cron/anomaly-check を叩き、直近24時間の
# ゴールド活動・リデーム状況を集計して Discord に流す(lib/security/anomaly.ts)。
# CRON_SECRET: Cron 認証。Vercel が Authorization: Bearer <CRON_SECRET> を自動付与。
#   未設定だとエンドポイントは 503 を返す(開放しない)ので、本番では必ず設定する。
CRON_SECRET=
# ダイジェストの送信先 webhook。未設定なら DISCORD_FEEDBACK_WEBHOOK_URL に相乗り。
# どちらも未設定なら集計だけ走り送信はスキップ。
DISCORD_ALERT_WEBHOOK_URL=

# --- α テスター用 creator 自動付与 (decisions.md H-001) ---
# このリストのメアド(カンマ区切り、case-insensitive)でログインしたユーザーは
# 自動で is_creator = true に昇格する。α 期間中に admin 手動付与の手間を
# 省くための暫定仕組み。Phase 2 で creator 申請 UI を作るときに撤去。
# 未設定なら機能オフ(従来通り admin が手動付与)。
# 例: ALPHA_AUTO_CREATOR_EMAILS=tester1@example.com,tester2@example.com
ALPHA_AUTO_CREATOR_EMAILS=

# --- α 暫定回避:Connect 未完了でも無料商品は公開可 ---
# "true" のときだけ有効化。creator が Stripe Connect の本人確認で詰まっても
# 価格 0 円(無料)商品なら公開できるようにする。有料商品は引き続き Connect
# 必須(destination charge / 30% fee の整合のため)。
# Phase 2 で Connect onboarding UX 改善が入ったら撤去予定。
ALPHA_ALLOW_FREE_WITHOUT_CONNECT=

# --- α テスター用 Discord 招待 URL ---
# TopHeader の通知ベル(現状未実装)を α テスター向けの Discord 招待
# リンクに転用する。公開可能な情報なので NEXT_PUBLIC_ 名で OK。
# 未設定なら従来通りの disabled ボタンに戻る(自動 fallback)。
# 例: NEXT_PUBLIC_ALPHA_DISCORD_INVITE_URL=https://discord.gg/xxxxxxx
NEXT_PUBLIC_ALPHA_DISCORD_INVITE_URL=
