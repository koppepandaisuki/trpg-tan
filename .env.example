# =========================================================
# .env.example
# 実値は .env.local にコピーして入れる(.env.local は git 管理しない)
# =========================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 2 以降で使用) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに絶対に渡さない。lib/supabase/admin.ts でのみ参照。
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 7 以降で使用) ---
STRIPE_SECRET_KEY=
# Stripe Webhook の署名検証に必須(platform endpoint 用)
STRIPE_WEBHOOK_SECRET=
# Stripe Connect 用 webhook endpoint の署名検証(D-020 PR2 以降)。
# Dashboard で Connect endpoint (connect: true) を別途登録し、同じ URL
# `/api/stripe/webhook` に向け、その whsec をここに入れる。未設定の場合は
# platform endpoint だけが有効になる(Connect イベントは届かない)。
STRIPE_CONNECT_WEBHOOK_SECRET=
# 公開可能キー(クライアントから参照可能)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Feedback (α 期間中の収集) ---
# In-app feedback button が POST するサーバーから Discord webhook 経由で
# クローズドサーバーに転送する。未設定の場合は POST は 200 で受け付けるが
# Discord 配信は走らない(α 起ち上げ時の運用猶予)。
DISCORD_FEEDBACK_WEBHOOK_URL=

# --- α テスター用 creator 自動付与 (decisions.md H-001) ---
# このリストのメアド(カンマ区切り、case-insensitive)でログインしたユーザーは
# 自動で is_creator = true に昇格する。α 期間中に admin 手動付与の手間を
# 省くための暫定仕組み。Phase 2 で creator 申請 UI を作るときに撤去。
# 未設定なら機能オフ(従来通り admin が手動付与)。
# 例: ALPHA_AUTO_CREATOR_EMAILS=tester1@example.com,tester2@example.com
ALPHA_AUTO_CREATOR_EMAILS=
